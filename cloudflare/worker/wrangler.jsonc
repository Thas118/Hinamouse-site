{
  "name": "hinamouse-media-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "MEDIA_CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
